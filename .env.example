NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key

# --- Contact page (/api/contact) — powered by Resend ---
# Get an API key at https://resend.com
RESEND_API_KEY=your_resend_api_key
# Recipient inbox for enquiries (your real business email)
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Vallunar Website <no-reply@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Exact origin of the production site (no trailing slash).
# /api/contact rejects POSTs whose Origin header doesn't match.
SITE_ORIGIN=https://yourdomain.com
